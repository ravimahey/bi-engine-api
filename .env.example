# ------------------------------------------------------------------ application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=30000

# --------------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ordara_analytics
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_SSL=false
DB_LOGGING=true
# Local development only — use migrations everywhere else
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=false

# ---------------------------------------------------------------------- swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --------------------------------------------------------------------- throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------ auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values so a leaked access secret can't forge refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Next.js app origin — post-Google-login redirect target and a required CORS origin.
FRONTEND_URL=http://localhost:3001
# Leave blank for localhost; set to a shared parent domain in staging/production
# (e.g. ".ordara.com") so the access/refresh cookies work across subdomains.
COOKIE_DOMAIN=

OTP_EXPIRES_MINUTES=15

# ------------------------------------------------------------------------ mail
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ordara Analytics <noreply@ordara.com>
