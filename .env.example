# ------------------------------------------------------------------ application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=30000

# --------------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ordara_analytics
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_SSL=false
DB_LOGGING=true
# Local development only — use migrations everywhere else
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=false

# ---------------------------------------------------------------------- swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --------------------------------------------------------------------- throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------ auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values so a leaked access secret can't forge refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Next.js app origin — post-Google-login redirect target and a required CORS origin.
FRONTEND_URL=http://localhost:3001
# Leave blank for localhost; set to a shared parent domain in staging/production
# (e.g. ".ordara.com") so the access/refresh cookies work across subdomains.
COOKIE_DOMAIN=

OTP_EXPIRES_MINUTES=15

# ------------------------------------------------------------------------ mail
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ordara Analytics <noreply@ordara.com>

# ------------------------------------------------------------------ quickbooks
# https://developer.intuit.com/app/developer/dashboard — sandbox app for dev/staging
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox | production
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback

# ------------------------------------------------------------------------ xero
# https://developer.xero.com/app/manage — the callback below must be listed as
# a redirect URI on the Xero app exactly as written.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_CALLBACK_URL=http://localhost:8000/api/v1/xero/callback
# Webhooks tab of the Xero app — signs every x-xero-signature header.
XERO_WEBHOOK_SECRET=

# ------------------------------------------------------------------ providers
# AES-256 key (32 bytes) encrypting every provider_connections OAuth token at
# rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# -------------------------------------------------------------------------- ai
# Gemini key from https://aistudio.google.com/apikey — use a paid-tier key in
# production (free-tier prompts may be used to improve Google models).
# AI_ENABLED=false or a blank key disables explanations (plain data still returned).
AI_ENABLED=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=25000
# Max model round-trips per Ask Ordaraa question (tool calls + final answer).
AI_MAX_TOOL_ROUNDS=4
